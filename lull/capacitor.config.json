{
  "appId": "com.kusgrupgames.lull",
  "appName": "Lull",
  "webDir": "www",
  "android": {
    "backgroundColor": "#05070d",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#05070d",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#070d14",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    }
  }
}
