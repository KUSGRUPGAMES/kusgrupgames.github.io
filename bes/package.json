{
  "name": "bes",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "jest",
    "deps:check": "node tools/check-expo-versions.js",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run deps:check",
    "db:verify": "bash tools/verify-db.sh",
    "bundle": "expo export --platform android --output-dir .expo/verify-bundle && expo export --platform ios --output-dir .expo/verify-bundle-ios",
    "preview": "expo export --platform web --output-dir .expo/web-build --clear && node tools/preview.js all",
    "verify": "npm run gate && npm run bundle",
    "import:quran": "node --experimental-strip-types tools/import-quran.js",
    "import:translation": "node --experimental-strip-types tools/import-translation.js",
    "probe:reciters": "node tools/probe-reciters.js",
    "test:logic": "jest --selectProjects mantik",
    "test:ui": "jest --selectProjects bilesen",
    "store:shots": "node tools/store-shots.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "playwright-core": "^1.63.0",
    "pngjs": "^3.4.0",
    "test-renderer": "^1.3.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  }
}
